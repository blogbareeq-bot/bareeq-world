# Production default: the approved Studio Cedar release is bundled for its pilot article.
# Other unchanged articles restore their published OpenAI Cedar + Marin assets from cache.
BAREEQ_TTS_PROVIDER=openai

# Keep as an encrypted Cloudflare Pages Production Secret. It is used only when
# an unchanged Cedar/Marin asset cannot be restored from the published cache.
OPENAI_API_KEY=

# OpenAI per-build cost guard for a full dual-voice regeneration.
OPENAI_TTS_BUILD_WARNING_USD=8
OPENAI_TTS_BUILD_HARD_LIMIT_USD=12

# Optional cache origin. Unchanged audio is restored from the live site at no new TTS cost.
BAREEQ_AUDIO_CACHE_ORIGIN=https://bareeqworld.com

# Local release verification only. Never set this in Production: it permits a build
# containing only bundled/available audio when the cache and synthesis key are offline.
# BAREEQ_AUDIO_ALLOW_PARTIAL=1

# Explicit rollback provider: set BAREEQ_TTS_PROVIDER=azure.
# Azure mode publishes both agreed Saudi voices: Hamed + Zariyah.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_SYNTHESIS_RATE=0%

# Azure cost guard retained for rollback builds.
AZURE_SPEECH_FREE_MONTHLY_CHARS=500000
AZURE_SPEECH_BUILD_WARNING_CHARS=400000
AZURE_SPEECH_BUILD_HARD_LIMIT_CHARS=450000

# Optional local-only Voice Lab settings. Leave the seed empty for a new blind order.
BAREEQ_VOICE_LAB_SEED=
BAREEQ_VOICE_LAB_PORT=4174
