# Required for the first production build if Azure article audio has not already been generated.
AZURE_SPEECH_KEY=

# Recommended. Defaults to eastus; set it explicitly to match the Azure Speech resource region.
AZURE_SPEECH_REGION=eastus

# Recommended. Copy the Endpoint shown in Azure > bareeq-speech > Keys and Endpoint.
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/

# Optional. Saudi Arabic neural voice. Hamed is the default; Zariyah is the female alternative.
AZURE_SPEECH_VOICE=ar-SA-HamedNeural

# Optional SSML prosody rate. Use values such as 0%, -3%, +5%.
AZURE_SPEECH_SYNTHESIS_RATE=0%

# Optional cache origin for reusing unchanged article audio on later deployments.
BAREEQ_AUDIO_CACHE_ORIGIN=https://bareeqworld.com

# Cost guard. These values protect against unexpectedly large synthesis runs.
AZURE_SPEECH_FREE_MONTHLY_CHARS=500000
AZURE_SPEECH_BUILD_WARNING_CHARS=400000
AZURE_SPEECH_BUILD_HARD_LIMIT_CHARS=450000

