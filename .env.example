# V4.18.2 production target: Gemini 3.1 Flash TTS Preview + Sadaltager for
# every published article. Add GEMINI_API_KEY as an encrypted Cloudflare Pages
# Production Secret. Synthesis is sequential and progressive: completed Sadaltager
# articles are reused from the live cache; persistent 429/time-budget deferrals keep
# the approved Cedar/Hamed fallback for the remaining articles until a later deployment.
BAREEQ_TTS_PROVIDER=gemini
GEMINI_API_KEY=

# Conservative free-tier pacing and short Arabic chunks.
GEMINI_TTS_MIN_INTERVAL_MS=9000
GEMINI_TTS_MAX_REQUEST_BYTES=2400
BAREEQ_TTS_MAX_RETRIES=8
BAREEQ_GEMINI_MAX_REQUESTS_PER_BUILD=80
BAREEQ_GEMINI_SYNTHESIS_BUDGET_MS=780000

# Offline/instant rollback: set BAREEQ_TTS_PROVIDER=bundled to restore the locked
# Cedar + Azure Hamed recordings with 0 synthesis requests and no API key.

# Optional deliberate upgrade only: set BAREEQ_TTS_PROVIDER=openai and add this as
# an encrypted Cloudflare Pages Production Secret to regenerate Cedar + Marin.
OPENAI_API_KEY=

# OpenAI per-build cost guard for a full dual-voice regeneration.
OPENAI_TTS_BUILD_WARNING_USD=8
OPENAI_TTS_BUILD_HARD_LIMIT_USD=12

# Cache origin used by Gemini/OpenAI/Azure regeneration modes.
BAREEQ_AUDIO_CACHE_ORIGIN=https://bareeqworld.com

# Local release verification only. Never set this in Production.
# BAREEQ_AUDIO_ALLOW_PARTIAL=1

# V4.21 pre-activation Google Cloud Text-to-Speech path.
# Keep BAREEQ_CLOUD_TTS_ACTIVATE=0 until CNTXT links billing to project bareeq-tts,
# Cloud Text-to-Speech is enabled, roles/aiplatform.user is granted, and the
# one-article paid smoke test is explicitly approved. The normal build sends
# zero Cloud TTS requests while this remains 0.
GOOGLE_CLOUD_PROJECT=bareeq-tts
GOOGLE_CLOUD_TTS_REGION=global
BAREEQ_CLOUD_TTS_ACTIVATE=0

# Encrypted Production Secret after activation. Paste the complete service-account
# JSON as one secret value. Never commit a real credential into this file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Conservative Cloud TTS request/chunk guards for the 11-article backlog.
GOOGLE_CLOUD_TTS_MAX_REQUEST_BYTES=3200
GOOGLE_CLOUD_TTS_MIN_INTERVAL_MS=500
BAREEQ_CLOUD_TTS_MAX_REQUESTS_PER_BUILD=100
BAREEQ_CLOUD_TTS_MAX_CHARS_PER_BUILD=120000

# Explicit regeneration provider: set BAREEQ_TTS_PROVIDER=azure.
# Azure mode publishes both agreed Saudi voices: Hamed + Zariyah.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_SYNTHESIS_RATE=0%

# Azure cost guard retained for rollback builds.
AZURE_SPEECH_FREE_MONTHLY_CHARS=500000
AZURE_SPEECH_BUILD_WARNING_CHARS=400000
AZURE_SPEECH_BUILD_HARD_LIMIT_CHARS=450000

# Optional cumulative monthly ledger. Copy the current month-to-date character
# usage from the Azure portal before a deliberate Azure synthesis run. Leaving it
# empty produces an explicit warning; setting it enables projected-usage alerts.
AZURE_SPEECH_MONTHLY_USED_CHARS=
AZURE_SPEECH_MONTHLY_WARNING_CHARS=400000

# Optional local-only Voice Lab settings. Leave the seed empty for a new blind order.
BAREEQ_VOICE_LAB_SEED=
BAREEQ_VOICE_LAB_PORT=4174
