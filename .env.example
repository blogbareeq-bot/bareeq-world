# V4.17.1 production target: Gemini 3.1 Flash TTS Preview + Sadaltager.
# Add GEMINI_API_KEY as an encrypted Cloudflare Pages Production Secret.
# The first deployment generates static MP3 files; unchanged later builds restore them
# from the live cache instead of synthesizing them again.
BAREEQ_TTS_PROVIDER=gemini
GEMINI_API_KEY=

# Conservative free-tier pacing and 60–90 second Arabic chunks.
GEMINI_TTS_MIN_INTERVAL_MS=6500
GEMINI_TTS_MAX_REQUEST_BYTES=2400

# Offline/instant rollback: set BAREEQ_TTS_PROVIDER=bundled to restore the locked
# Cedar + Azure Hamed recordings with 0 synthesis requests and no API key.

# Optional deliberate upgrade only: set BAREEQ_TTS_PROVIDER=openai and add this as
# an encrypted Cloudflare Pages Production Secret to regenerate Cedar + Marin.
OPENAI_API_KEY=

# OpenAI per-build cost guard for a full dual-voice regeneration.
OPENAI_TTS_BUILD_WARNING_USD=8
OPENAI_TTS_BUILD_HARD_LIMIT_USD=12

# Cache origin used by Gemini/OpenAI/Azure regeneration modes.
BAREEQ_AUDIO_CACHE_ORIGIN=https://bareeqworld.com

# Local release verification only. Never set this in Production.
# BAREEQ_AUDIO_ALLOW_PARTIAL=1

# Explicit regeneration provider: set BAREEQ_TTS_PROVIDER=azure.
# Azure mode publishes both agreed Saudi voices: Hamed + Zariyah.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_SYNTHESIS_RATE=0%

# Azure cost guard retained for rollback builds.
AZURE_SPEECH_FREE_MONTHLY_CHARS=500000
AZURE_SPEECH_BUILD_WARNING_CHARS=400000
AZURE_SPEECH_BUILD_HARD_LIMIT_CHARS=450000

# Optional local-only Voice Lab settings. Leave the seed empty for a new blind order.
BAREEQ_VOICE_LAB_SEED=
BAREEQ_VOICE_LAB_PORT=4174
