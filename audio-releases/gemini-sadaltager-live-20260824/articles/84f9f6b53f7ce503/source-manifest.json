        {
          "id": "b0091",
          "type": "h2",
          "match": "ماذا عن مستقبل الوظايف",
          "start": 0.588346,
          "end": 0.609399
        },
        {
          "id": "b0092",
          "type": "paragraph",
          "match": "من المبكر اختزال الاثر في جملة سيستبدل الوكلاء الموظفين الوظيفة الواحدة تجمع مهاما مختلفة بعضها متكرر وقابل للتفويض وبعض",
          "start": 0.609399,
          "end": 0.75037
        },
        {
          "id": "b0093",
          "type": "paragraph",
          "match": "الارجح في المدى القريب ان يعاد توزيع المهام قبل ان تختفي المهن دفعة واحدة قد يقضي الموظف وقتا اقل في الجمع والنسخ ووقتا ",
          "start": 0.75037,
          "end": 0.891835
        },
        {
          "id": "b0094",
          "type": "paragraph",
          "match": "لكن حجم الاثر وسرعته سيختلفان بين القطاعات والبلدان ويتوقفان على التكلفة والدقة والتنظيم وثقة الناس الادعاءات القاطعة هن",
          "start": 0.891835,
          "end": 1
        }
      ],
