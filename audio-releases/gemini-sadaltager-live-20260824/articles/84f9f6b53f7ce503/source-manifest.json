    {
      "characters": 1283,
      "sync": [
        {
          "id": "b0084",
          "type": "list-item",
          "match": "هل اختبر النظام على حالات الفشل والهجمات لا على المسار المثالي فقط",
          "start": 0,
          "end": 0.05671
        },
        {
          "id": "b0085",
          "type": "list-item",
          "match": "ماذا يحدث اذا انقطع الاتصال او تعارض مصدران او لم يفهم الهدف",
          "start": 0.05671,
          "end": 0.11057
        },
        {
          "id": "b0086",
          "type": "paragraph",
          "match": "في المهام الحساسة التصميم الامن لا يجعل الموافقة عايقا مزعجا بل يجعلها جزءا من جودة المنتج",
          "start": 0.11057,
          "end": 0.186534
        },
        {
          "id": "b0087",
          "type": "h2",
          "match": "هل الوكيل هو نفسه الاتمتة",
          "start": 0.186534,
          "end": 0.211409
        },
        {
          "id": "b0088",
          "type": "paragraph",
          "match": "الاتمتة التقليدية ممتازة عندما تكون القاعدة ثابتة تصل فاتورة الى صندوق محدد فتنسخ الى مجلد وترسل اشعارات مسارها واضح وقا",
          "start": 0.211409,
          "end": 0.314159
        },
        {
          "id": "b0089",
          "type": "paragraph",
          "match": "اما الوكيل فيضيف مرونة عندما تختلف الحالات ويصعب كتابة قاعدة لكل احتمال لكنه يدفع ثمن هذه المرونة بانخفاض قابلية التنبو ",
          "start": 0.314159,
          "end": 0.482076
        },
        {
          "id": "b0090",
          "type": "paragraph",
          "match": "ليس الاكثر وكالة هو الافضل دايما اذا انجز سير عمل بسيط المهمة بثبات فلا فايدة من اضافة استقلال معقد لمجرد ان الاسم احدث",
          "start": 0.482076,
          "end": 0.588346
