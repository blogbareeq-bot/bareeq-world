        },
        {
          "id": "b0071",
          "type": "list-item",
          "match": "افراط في الصلاحيات امتلاك ادوات اكثر مما تحتاجه المهمة",
          "start": 0.451711,
          "end": 0.494205
        },
        {
          "id": "b0072",
