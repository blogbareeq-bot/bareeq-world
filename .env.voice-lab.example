# انسخ هذا الملف محليًا باسم .env.voice-lab. لا ترفعه إلى Git ولا ترسل المفاتيح في المحادثة.

# OpenAI
OPENAI_API_KEY=

# ElevenLabs: استخدم معرف صوت واحد نفسه لمقارنة Multilingual v2 وEleven v3 بعدالة.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Cloud: استخدم أحد مساري المصادقة.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_ACCESS_TOKEN=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Munsit
MUNSIT_API_KEY=
MUNSIT_VOICE_ID=ar-najdi-male-2
# أدخل السعر الظاهر في لوحة حسابك لكل 1000 حرف حتى يعمل حاجز الميزانية.
MUNSIT_COST_PER_1000_CHARS_USD=

# حد اختياري لترتيب المقارنة العمياء نفسه عند إعادة البناء.
BAREEQ_VOICE_LAB_SEED=
