    {
      "characters": 885,
      "sync": [
        {
          "id": "b0122",
          "type": "h3",
          "match": "هل كل ما يسمى agent يعمل باستقلال",
          "start": 0,
          "end": 0.048634
        },
        {
          "id": "b0123",
          "type": "paragraph",
          "match": "لا بعض المنتجات سير عمل مضبوط يستخدم نموذجا في خطوة أو أكثر الاسم التجاري لا يكشف وحده مقدار الاستقلال أو الصلاحيات",
          "start": 0.048634,
          "end": 0.195932
        },
        {
          "id": "b0124",
          "type": "h3",
          "match": "هل يمكن الوثوق به بلا مراجعة بشرية",
          "start": 0.195932,
          "end": 0.244101
        },
        {
          "id": "b0125",
          "type": "paragraph",
          "match": "يعتمد ذلك على المهمة وعواقب الخطأ قد تكون الأتمتة مقبولة في خطوة منخفضة المخاطر وقابلة للتراجع بينما تحتاج الأفعال المال",
          "start": 0.244101,
          "end": 0.461537
        },
        {
          "id": "b0126",
          "type": "h3",
          "match": "ما الفرق بين الوكيل والأتمتة التقليدية",
          "start": 0.461537,
          "end": 0.505754
        },
        {
          "id": "b0127",
          "type": "paragraph",
          "match": "الأتمتة تتبع مسارا محددا مسبقا بينما يستطيع الوكيل اختيار بعض الخطوات بناء على السياق المرونة أكبر لكن قابلية التنبؤ أقل",
          "start": 0.505754,
          "end": 0.649239
        },
        {
          "id": "b0128",
          "type": "h3",
          "match": "ما أهم احتياط عند استخدام وكيل",
          "start": 0.649239,
          "end": 0.691596
        },
        {
          "id": "b0129",
          "type": "paragraph",
          "match": "امنحه أقل قدر من البيانات والصلاحيات واجعل الإرسال والحذف والدفع والنشر وتغيير الأذونات خلف موافقة واضحة وقابلة للتدقيق",
          "start": 0.691596,
          "end": 0.815762
        },
        {
          "id": "b0130",
          "type": "h3",
          "match": "هل سيقضي الوكلاء على الوظائف",
          "start": 0.815762,
          "end": 0.852772
        },
        {
          "id": "b0131",
          "type": "paragraph",
          "match": "لا توجد نتيجة محسومة من المرجح أن تتغير مجموعات من المهام داخل الوظائف أولا ويختلف الأثر باختلاف القطاع والجودة والتنظيم",
          "start": 0.852772,
          "end": 1
        }
      ],
      "syncIds": [
        "b0122",
