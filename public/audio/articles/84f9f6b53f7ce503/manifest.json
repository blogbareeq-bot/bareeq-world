    {
      "characters": 1624,
      "sync": [
        {
          "id": "b0089",
          "type": "paragraph",
          "match": "أما الوكيل فيضيف مرونة عندما تختلف الحالات ويصعب كتابة قاعدة لكل احتمال لكنه يدفع ثمن هذه المرونة بانخفاض قابلية التنبؤ ",
          "start": 0,
          "end": 0.134663
        },
        {
          "id": "b0090",
          "type": "paragraph",
          "match": "ليس الأكثر وكالة هو الأفضل دائما إذا أنجز سير عمل بسيط المهمة بثبات فلا فائدة من إضافة استقلال معقد لمجرد أن الاسم أحدث",
          "start": 0.134663,
          "end": 0.219888
        },
        {
          "id": "b0091",
          "type": "h2",
          "match": "ماذا عن مستقبل الوظائف",
          "start": 0.219888,
          "end": 0.236772
        },
        {
          "id": "b0092",
          "type": "paragraph",
          "match": "من المبكر اختزال الأثر في جملة سيستبدل الوكلاء الموظفين الوظيفة الواحدة تجمع مهاما مختلفة بعضها متكرر وقابل للتفويض وبعض",
          "start": 0.236772,
          "end": 0.349826
        },
        {
          "id": "b0093",
          "type": "paragraph",
          "match": "الأرجح في المدى القريب أن يعاد توزيع المهام قبل أن تختفي المهن دفعة واحدة قد يقضي الموظف وقتا أقل في الجمع والنسخ ووقتا ",
          "start": 0.349826,
          "end": 0.463275
        },
        {
          "id": "b0094",
          "type": "paragraph",
          "match": "لكن حجم الأثر وسرعته سيختلفان بين القطاعات والبلدان ويتوقفان على التكلفة والدقة والتنظيم وثقة الناس الادعاءات القاطعة هن",
          "start": 0.463275,
          "end": 0.55002
        },
        {
          "id": "b0095",
          "type": "h2",
          "match": "ما الذي نعرفه وما الذي ما زال غير محسوم",
          "start": 0.55002,
          "end": 0.582485
        },
        {
          "id": "b0096",
          "type": "h3",
          "match": "نعرف بدرجة جيدة أن",
          "start": 0.582485,
          "end": 0.597032
        },
        {
          "id": "b0097",
          "type": "list-item",
          "match": "ربط النماذج بأدوات يوسع فائدتها العملية",
          "start": 0.597032,
          "end": 0.621579
        },
        {
          "id": "b0098",
          "type": "list-item",
          "match": "المهام المحددة والبيئات المنظمة أسهل من الأهداف المفتوحة",
          "start": 0.621579,
          "end": 0.653533
        },
        {
          "id": "b0099",
          "type": "list-item",
          "match": "الأخطاء قد تتراكم عبر الجولات والأفعال",
          "start": 0.653533,
          "end": 0.677825
        },
        {
          "id": "b0100",
          "type": "list-item",
          "match": "التقييم والتسجيل والمراجعة البشرية مهمة خصوصا مع الصلاحيات الحساسة",
          "start": 0.677825,
          "end": 0.713866
        },
        {
          "id": "b0101",
          "type": "h3",
          "match": "وما زلنا لا نعرف بدقة",
          "start": 0.713866,
          "end": 0.731478
        },
        {
          "id": "b0102",
          "type": "list-item",
          "match": "ما مستوى الاستقلال الآمن لكل نوع من المهام",
          "start": 0.731478,
          "end": 0.761644
        },
        {
          "id": "b0103",
          "type": "list-item",
          "match": "كيف ستتغير واجهات الحاسوب عندما يصبح الهدف أهم من التطبيق",
          "start": 0.761644,
          "end": 0.799091
        },
        {
          "id": "b0104",
          "type": "list-item",
          "match": "ما حجم التحول النهائي في سوق العمل",
          "start": 0.799091,
          "end": 0.825553
        },
        {
          "id": "b0105",
          "type": "list-item",
          "match": "أي معايير قانونية وتقنية ستصبح القاعدة المشتركة",
          "start": 0.825553,
          "end": 0.853676
        },
        {
          "id": "b0106",
          "type": "paragraph",
          "match": "الفكرة حقيقية والاستخدام يتوسع لكن الاسم سبق أحيانا درجة النضج",
          "start": 0.853676,
          "end": 0.894673
        },
        {
          "id": "b0107",
          "type": "h2",
          "match": "مثال متوازن متجر إلكتروني صغير",
          "start": 0.894673,
          "end": 0.913434
        },
        {
          "id": "b0108",
          "type": "paragraph",
          "match": "يمكن لوكيل محدود الصلاحيات أن يجمع رسائل العملاء ويصنف أسباب الاستفسار ويقارنها بحالة الطلب ويقترح ردا ثم يجهز تقريرا أس",
          "start": 0.913434,
          "end": 1
        }
      ],
