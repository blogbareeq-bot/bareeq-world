    {
      "characters": 886,
      "sync": [
        {
          "id": "b0109",
          "type": "paragraph",
          "match": "لكن من الأفضل أن تتوقف عند الإنسان خطوات مثل",
          "start": 0,
          "end": 0.054258
        },
        {
          "id": "b0110",
          "type": "list-item",
          "match": "الموافقة على تعويض مالي",
          "start": 0.054258,
          "end": 0.083769
        },
        {
          "id": "b0111",
          "type": "list-item",
          "match": "تعديل سعر أو سياسة",
          "start": 0.083769,
          "end": 0.112172
        },
        {
          "id": "b0112",
          "type": "list-item",
          "match": "إرسال رسالة في شكوى حساسة",
          "start": 0.112172,
          "end": 0.146779
        },
        {
          "id": "b0113",
          "type": "list-item",
          "match": "حذف سجل أو كشف بيانات عميل",
          "start": 0.146779,
          "end": 0.186259
        },
        {
          "id": "b0114",
          "type": "paragraph",
          "match": "هكذا تصبح التقنية رافعة للعمل لا مقامرة بصلاحيات الحساب",
          "start": 0.186259,
          "end": 0.248538
        },
        {
          "id": "b0115",
          "type": "h2",
          "match": "الخلاصة",
          "start": 0.248538,
          "end": 0.254963
        },
        {
          "id": "b0116",
          "type": "paragraph",
          "match": "الوكلاء الأذكياء ليسوا شاتا أقوى فقط ولا موظفين رقميين مستقلين بالمعنى البشري إنهم أنظمة تجمع نموذجا وتعليمات وأدوات وحل",
          "start": 0.254963,
          "end": 0.434022
        },
        {
          "id": "b0117",
          "type": "paragraph",
          "match": "قوتها الحقيقية تأتي من اتصالها بالعالم الرقمي وهذا هو مصدر خطرها أيضا كلما زادت القدرة على الفعل ازدادت الحاجة إلى أقل ص",
          "start": 0.434022,
          "end": 0.681673
        },
        {
          "id": "b0118",
          "type": "paragraph",
          "match": "ولفهم كيف توظف الأنظمة أنماط البيانات قبل أن تتوقع ما ستكتبه اقرأ كيف يتوقع محرك البحث ما ستكتبه قبل أن تكمله",
          "start": 0.681673,
          "end": 0.81733
        },
        {
          "id": "b0119",
          "type": "h2",
          "match": "أسئلة شائعة",
          "start": 0.81733,
          "end": 0.829294
        },
        {
          "id": "b0120",
          "type": "h3",
          "match": "هل كل روبوت محادثة وكيل ذكي",
          "start": 0.829294,
          "end": 0.868996
        },
        {
          "id": "b0121",
          "type": "paragraph",
          "match": "لا قد يولد روبوت المحادثة ردودا فقط بينما يتطلب الوكيل عادة أدوات وحلقة تنفيذ وقدرة على اختيار خطوات ضمن هدف",
          "start": 0.868996,
          "end": 1
        }
      ],
      "syncIds": [
