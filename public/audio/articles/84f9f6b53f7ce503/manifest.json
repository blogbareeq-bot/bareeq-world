    {
      "characters": 1711,
      "sync": [
        {
          "id": "b0066",
          "type": "paragraph",
          "match": "توضح خبرة بناء اختبارات الوكلاء أن العمل متعدد الجولات والأدوات أصعب تقييما من إجابة منفردة فالوكيل يغير حالة البيئة وتت",
          "start": 0,
          "end": 0.126365
        },
        {
          "id": "b0067",
          "type": "h2",
          "match": "الخطر الأكبر حين يقرأ التعليمات الخاطئة وينفذها",
          "start": 0.126365,
          "end": 0.150409
        },
        {
          "id": "b0068",
          "type": "paragraph",
          "match": "قد يفتح الوكيل صفحة أو مستندا يحتوي على نص خبيث صمم ليبدو كتعليمات له إذا لم يفصل النظام جيدا بين أمر المستخدم ومحتوى ال",
          "start": 0.150409,
          "end": 0.256245
        },
        {
          "id": "b0069",
          "type": "paragraph",
          "match": "تزداد خطورة الهجوم إذا كان الوكيل يستطيع الإرسال أو التنزيل أو تعديل البيانات حينها لا يبقى الخلل داخل نص بل قد يتحول إل",
          "start": 0.256245,
          "end": 0.336973
        },
        {
          "id": "b0070",
          "type": "paragraph",
          "match": "وهناك مخاطر متصلة",
          "start": 0.336973,
          "end": 0.347705
        },
        {
          "id": "b0071",
          "type": "list-item",
          "match": "إفراط في الصلاحيات امتلاك أدوات أكثر مما تحتاجه المهمة",
          "start": 0.347705,
          "end": 0.380414
        },
        {
          "id": "b0072",
          "type": "list-item",
          "match": "تسرب البيانات نقل محتوى حساس إلى أداة أو جهة غير مقصودة",
          "start": 0.380414,
          "end": 0.418145
        },
        {
          "id": "b0073",
          "type": "list-item",
          "match": "إساءة استخدام الذاكرة تخزين معلومة خاطئة أو خبيثة تؤثر في مهام لاحقة",
          "start": 0.418145,
          "end": 0.459846
        },
        {
          "id": "b0074",
          "type": "list-item",
          "match": "ضعف التتبع عدم القدرة على معرفة لماذا اتخذ النظام خطوة معينة",
          "start": 0.459846,
          "end": 0.498161
        },
        {
          "id": "b0075",
          "type": "list-item",
          "match": "الاستنزاف تكرار محاولات طويلة تستهلك وقتا وموارد وتكلفة",
          "start": 0.498161,
          "end": 0.528651
        },
        {
          "id": "b0076",
          "type": "paragraph",
          "match": "لهذا تؤكد أطر إدارة مخاطر الذكاء الاصطناعي على القياس والمراقبة والإدارة عبر دورة حياة النظام لا على وعد تسويقي بأن الأد",
          "start": 0.528651,
          "end": 0.605152
        },
        {
          "id": "b0077",
          "type": "h2",
          "match": "قاعدة عملية أقل صلاحية وأوضح موافقة",
          "start": 0.605152,
          "end": 0.626616
        },
        {
          "id": "b0078",
          "type": "paragraph",
          "match": "قبل ربط وكيل بحساب أو أداة حقيقية اسأل",
          "start": 0.626616,
          "end": 0.653335
        },
        {
          "id": "b0079",
          "type": "list-item",
          "match": "ما أقل البيانات التي يحتاجها",
          "start": 0.653335,
          "end": 0.671926
        },
        {
          "id": "b0080",
          "type": "list-item",
          "match": "هل يحتاج القراءة فقط أم الكتابة أيضا",
          "start": 0.671926,
          "end": 0.697745
        },
        {
          "id": "b0081",
          "type": "list-item",
          "match": "ما الأفعال التي يجب أن تتوقف عند موافقة بشرية",
          "start": 0.697745,
          "end": 0.728131
        },
        {
          "id": "b0082",
          "type": "list-item",
          "match": "هل يمكن التراجع عن الإجراء",
          "start": 0.728131,
          "end": 0.746488
        },
        {
          "id": "b0083",
          "type": "list-item",
          "match": "هل تسجل الخطوات والأدوات والنتائج للمراجعة",
          "start": 0.746488,
          "end": 0.769283
        },
        {
          "id": "b0084",
          "type": "list-item",
          "match": "هل اختبر النظام على حالات الفشل والهجمات لا على المسار المثالي فقط",
          "start": 0.769283,
          "end": 0.810867
        },
        {
          "id": "b0085",
          "type": "list-item",
          "match": "ماذا يحدث إذا انقطع الاتصال أو تعارض مصدران أو لم يفهم الهدف",
          "start": 0.810867,
          "end": 0.850361
        },
        {
          "id": "b0086",
          "type": "paragraph",
          "match": "في المهام الحساسة التصميم الآمن لا يجعل الموافقة عائقا مزعجا بل يجعلها جزءا من جودة المنتج",
          "start": 0.850361,
          "end": 0.906064
        },
        {
          "id": "b0087",
          "type": "h2",
          "match": "هل الوكيل هو نفسه الأتمتة",
          "start": 0.906064,
          "end": 0.924305
        },
        {
          "id": "b0088",
          "type": "paragraph",
          "match": "الأتمتة التقليدية ممتازة عندما تكون القاعدة ثابتة تصل فاتورة إلى صندوق محدد فتنسخ إلى مجلد وترسل إشعارات مسارها واضح وقا",
          "start": 0.924305,
          "end": 1
        }
      ],
