    {
      "characters": 1506,
      "sync": [
        {
          "id": "b0068",
          "type": "paragraph",
          "match": "اطلب المساندة إذا ظهرت آثار تعاقدية أو مالية استشر الشخص المختص وإذا استمر الضغط وأصبح يعطل حياتك اطلب دعما صحيا مناسبا",
          "start": 0,
          "end": 0.081987
        },
        {
          "id": "b0069",
          "type": "paragraph",
          "match": "لاحظ أن الإطار لم يحل المشكلة وظيفته أن يمنع الغموض من قيادة كل حركة",
          "start": 0.081987,
          "end": 0.134365
        },
        {
          "id": "b0070",
          "type": "h2",
          "match": "ثلاثة أخطاء تجعل الموقف أثقل",
          "start": 0.134365,
          "end": 0.151342
        },
        {
          "id": "b0071",
          "type": "h3",
          "match": "محاولة حل المستقبل كله اليوم",
          "start": 0.151342,
          "end": 0.16832
        },
        {
          "id": "b0072",
          "type": "paragraph",
          "match": "السؤال كيف ستنتهي هذه القصة قد لا يملك جوابا الآن استبدله مؤقتا بـ ما الخطوة التي تحسن موقفي خلال الساعات أو الأيام القل",
          "start": 0.16832,
          "end": 0.259645
        },
        {
          "id": "b0073",
          "type": "h3",
          "match": "مساواة المشاعر بالحقائق",
          "start": 0.259645,
          "end": 0.270668
        },
        {
          "id": "b0074",
          "type": "paragraph",
          "match": "الخوف حقيقي بوصفه تجربة لكنه لا يثبت أن السيناريو المخيف سيقع والغضب قد يشير إلى أن حدا مهما تم تجاوزه لكنه لا يحدد وحده",
          "start": 0.270668,
          "end": 0.365591
        },
        {
          "id": "b0075",
          "type": "h3",
          "match": "طلب نصيحة من كل شخص",
          "start": 0.365591,
          "end": 0.381428
        },
        {
          "id": "b0076",
          "type": "paragraph",
          "match": "كثرة الآراء لا تعني جودة القرار اختر مصدرا مناسبا لكل نوع من الأسئلة وميز بين من يملك خبرة ومن يملك رأيا فقط",
          "start": 0.381428,
          "end": 0.462047
        },
        {
          "id": "b0077",
          "type": "h2",
          "match": "بطاقة بريق للمواقف الصعبة",
          "start": 0.462047,
          "end": 0.475984
        },
        {
          "id": "b0078",
          "type": "paragraph",
          "match": "عندما تضيق الصورة اختصر الإطار في خمس جمل",
          "start": 0.475984,
          "end": 0.505353
        },
        {
          "id": "b0079",
          "type": "list-item",
          "match": "أحتاج أولا إلى قدر كاف من الثبات لا إلى شعور مثالي بالهدوء",
          "start": 0.505353,
          "end": 0.549584
        },
        {
          "id": "b0080",
          "type": "list-item",
          "match": "سأفصل ما أعرفه عما أخشاه أو أرجحه",
          "start": 0.549584,
          "end": 0.575709
        },
        {
          "id": "b0081",
          "type": "list-item",
          "match": "سأضع جهدي في الجزء الذي أستطيع التأثير فيه",
          "start": 0.575709,
          "end": 0.605636
        },
        {
          "id": "b0082",
          "type": "list-item",
          "match": "سأختار الخطوة التالية الأقل إغلاقا للخيارات ما دام الوقت يسمح",
          "start": 0.605636,
          "end": 0.643417
        },
        {
          "id": "b0083",
          "type": "list-item",
          "match": "سأطلب المساندة المناسبة إذا تجاوز الأمر ما أستطيع إدارته وحدي",
          "start": 0.643417,
          "end": 0.681072
        },
        {
          "id": "b0084",
          "type": "h2",
          "match": "الخلاصة",
          "start": 0.681072,
          "end": 0.684747
        },
        {
          "id": "b0085",
          "type": "paragraph",
          "match": "القوة في المواقف الصعبة ليست أن تملك الإجابة فورا ولا أن تمنع نفسك من الخوف أو الحزن القوة العملية أبسط من ذلك ألا تسمح ",
          "start": 0.684747,
          "end": 0.826536
        },
        {
          "id": "b0086",
          "type": "paragraph",
          "match": "حين تصبح الصورة ثقيلة لا تحاول حملها كلها دفعة واحدة ثبت نفسك بما يكفي اعرف ما أمامك اختر الجزء الذي تستطيع التأثير فيه ",
          "start": 0.826536,
          "end": 0.928529
        },
        {
          "id": "b0087",
          "type": "paragraph",
          "match": "فالقرار الجيد لا يحتاج دائما إلى يقين كامل لكنه يحتاج إلى مساحة كافية كي لا يتخذ الخوف القرار بالنيابة عنك",
          "start": 0.928529,
          "end": 1
        }
      ],
