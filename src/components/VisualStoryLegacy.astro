---
import StoryVisual from './visual-story/StoryVisual.astro';
import type { VisualStoryData } from '../types/visual-story';
interface Props { story: VisualStoryData; }
const { story } = Astro.props;
const toneFor = (index: number) => ['deep','ivory','mist','deep','sand','deep','ivory','mist','deep'][index % 9];
const layoutFor = (kind: string, index: number) => {
  if (kind === 'takeaway') return 'closing';
  if (kind === 'evidence' || kind === 'question' || kind === 'reflection') return 'center';
  if (kind === 'contrast' || kind === 'myth') return 'reverse';
  return index % 2 === 0 ? 'split' : 'reverse';
};
const firstCardId = story.cards[0]?.id || '';
---
<div
  class="visual-story atlas-v3"
  data-visual-story
  data-atlas-v3
  data-story-key={story.slug}
  data-story-title={story.title}
  data-card-count={story.cards.length}
  data-director={story.director.mood}
  hidden
>
  <div class="visual-story__backdrop" data-visual-close></div>
  <section class="visual-story__dialog" role="dialog" aria-modal="true" aria-labelledby="visual-story-title" tabindex="-1" data-visual-dialog>
    <header class="visual-story__header">
      <a class="visual-story__brand" href="/" aria-label="بريق — نافذتك إلى المعرفة">
        <img src="/images/bareeq-window-mark.svg" alt="" width="90" height="150" decoding="async" />
        <span><b>نافذة بريق</b><small>رحلة قصيرة تعيد اكتشاف المقال</small></span>
      </a>
      <div class="atlas-v3__progress-shell" aria-hidden="true"><i></i></div>
      <button class="visual-story__icon-button" type="button" data-visual-share aria-label="مشاركة المشهد الحالي">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.5-4.4M8.2 13.2l7.5 4.4"/></svg>
      </button>
      <button class="visual-story__icon-button" type="button" data-visual-close aria-label="إغلاق نافذة بريق">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </header>

    <div class="visual-story__track" data-visual-track aria-live="polite">
      {story.cards.map((card, index) => (
        <article
          class:list={[
            'visual-story__card',
            `visual-story__card--${card.visual}`,
            `atlas-v3__scene--${toneFor(index)}`,
            `atlas-v3__layout--${layoutFor(card.kind, index)}`,
            { 'is-active': index === 0 }
          ]}
          data-visual-card
          data-card-id={card.id}
          data-index={index}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="visual-story__copy">
            <span class="visual-story__kicker">{card.kicker}</span>
            <h2 id={index === 0 ? 'visual-story-title' : undefined}>{card.title}</h2>
            <p>{card.body}</p>
          </div>
          <div class="visual-story__art"><StoryVisual kind={card.visual} index={index} /></div>
          {card.kind === 'takeaway' && <img class="atlas-v3__signature" src="/images/bareeq-window-signature.svg" alt="" width="900" height="484" loading="lazy" decoding="async" />}
        </article>
      ))}
    </div>

    <footer class="visual-story__footer" aria-label="التنقل بين مشاهد نافذة بريق">
      <a class="atlas-v3__home" href={`#visual=${encodeURIComponent(firstCardId)}`} aria-label="العودة إلى بداية النافذة" title="البداية"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5.5 10.5V20h13v-9.5M9.5 20v-6h5v6"/></svg></a>
      <button type="button" data-visual-prev aria-label="المشهد السابق" title="السابق"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg><span class="atlas-v3__sr-label">السابق</span></button>
      <span class="atlas-v3__count" aria-live="polite"><b data-visual-position>1</b> / {story.cards.length}</span>
      <button class="atlas-v3__next" type="button" data-visual-next aria-label="المشهد التالي" title="التالي"><span class="atlas-v3__sr-label">التالي</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
      <div class="visual-story__dots" role="tablist" aria-label="بطاقات نافذة بريق">
        {story.cards.map((card, index) => <button type="button" role="tab" data-visual-dot data-index={index} aria-label={`البطاقة ${index + 1}: ${card.title}`} aria-selected={index === 0 ? 'true' : 'false'}></button>)}
      </div>
    </footer>
    <p class="visual-story__status" data-visual-status aria-live="polite"></p>
  </section>
</div>

<style is:global>
  body.visual-story-open{overflow:hidden}
  .visual-story.atlas-v3{--story-accent:#12b8b1;--story-gold:#d7b374;--atlas-navy:#061b29;--atlas-navy2:#0a3140;--atlas-teal:#12b8b1;--atlas-teal2:#54d8d1;--atlas-ivory:#f4efe6;--atlas-paper:#fbf8f2;--atlas-mist:#edf5f3;--atlas-sand:#f5eadb;--atlas-gold:#d7b374;--atlas-ink:#192b39;--atlas-muted:#697983;--atlas-line:rgba(6,27,41,.11);position:fixed;inset:0;z-index:1000;direction:rtl;color:var(--atlas-ink)}
  .visual-story.atlas-v3 .visual-story__backdrop{position:absolute;inset:0;background:rgba(2,12,20,.86);backdrop-filter:blur(13px)}
  .visual-story.atlas-v3 .visual-story__dialog{position:absolute;inset:max(12px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left));max-width:1280px;margin:auto;display:grid;grid-template-rows:auto minmax(0,1fr) auto auto;overflow:hidden;border:1px solid rgba(84,216,209,.26);border-radius:30px;background:var(--atlas-paper);box-shadow:0 34px 110px rgba(0,0,0,.48);outline:0}
  .visual-story.atlas-v3 .visual-story__header{min-height:64px;display:grid;grid-template-columns:auto minmax(70px,1fr) auto auto;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--atlas-line);background:rgba(251,248,242,.92);position:relative;z-index:4}
  .visual-story.atlas-v3 .visual-story__header::after{content:'';position:absolute;right:0;bottom:-1px;width:34%;height:1px;background:linear-gradient(90deg,transparent,var(--atlas-gold),var(--atlas-teal),transparent);opacity:.6}
  .visual-story.atlas-v3 .visual-story__brand{display:flex;align-items:center;gap:9px;min-width:0;color:var(--atlas-navy);text-decoration:none}.visual-story.atlas-v3 .visual-story__brand img{width:52px;height:46px;object-fit:contain;filter:drop-shadow(0 6px 12px rgba(6,27,41,.15))}.visual-story.atlas-v3 .visual-story__brand span{display:grid}.visual-story.atlas-v3 .visual-story__brand b{font-family:var(--font-heading);font-size:.9rem}.visual-story.atlas-v3 .visual-story__brand small{font-size:.66rem;color:var(--atlas-muted);white-space:nowrap}
  .visual-story.atlas-v3 .atlas-v3__progress-shell{height:7px;border-radius:999px;background:rgba(6,27,41,.07);overflow:hidden}.visual-story.atlas-v3 .atlas-v3__progress-shell i{display:block;width:38%;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--atlas-teal),var(--atlas-gold));opacity:.7}
  .visual-story.atlas-v3 .visual-story__icon-button{width:40px;height:40px;display:grid;place-items:center;padding:0;border:1px solid var(--atlas-line);border-radius:999px;background:rgba(255,255,255,.78);color:var(--atlas-navy)}.visual-story.atlas-v3 .visual-story__icon-button svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .visual-story.atlas-v3 .visual-story__track{position:relative;min-height:0;overflow:hidden;background:var(--atlas-paper)}
  .visual-story.atlas-v3 .visual-story__card{position:absolute;inset:0;box-sizing:border-box;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,4vw,54px);align-items:center;padding:clamp(26px,4.2vw,58px);overflow:hidden;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .22s ease}.visual-story.atlas-v3 .visual-story__card.is-active{opacity:1;visibility:visible;pointer-events:auto}
  .visual-story.atlas-v3 .atlas-v3__scene--deep{color:#f4f3ed;background:radial-gradient(90% 72% at 82% 10%,rgba(18,184,177,.15),transparent 58%),linear-gradient(155deg,var(--atlas-navy),#082534 72%,#0b2d3a)}
  .visual-story.atlas-v3 .atlas-v3__scene--ivory{color:var(--atlas-ink);background:linear-gradient(180deg,#f7f2e9,var(--atlas-ivory))}.visual-story.atlas-v3 .atlas-v3__scene--mist{color:var(--atlas-ink);background:linear-gradient(180deg,#f6fbfa,var(--atlas-mist))}.visual-story.atlas-v3 .atlas-v3__scene--sand{color:var(--atlas-ink);background:linear-gradient(180deg,#fbf5eb,var(--atlas-sand))}
  .visual-story.atlas-v3 .visual-story__copy{min-width:0;max-width:66ch;min-height:0;max-height:none;overflow:visible;z-index:2}.visual-story.atlas-v3 .visual-story__kicker{display:inline-flex;align-items:center;gap:8px;margin:0 0 12px;color:var(--atlas-gold);font-size:.74rem;font-weight:800}.visual-story.atlas-v3 .visual-story__kicker::before{content:'';width:23px;height:1px;background:currentColor}.visual-story.atlas-v3 .visual-story__copy h2{max-width:21ch;margin:0;color:inherit;font-size:clamp(1.62rem,2.7vw,3.1rem);line-height:1.32;text-wrap:balance;overflow-wrap:anywhere}.visual-story.atlas-v3 .visual-story__copy p{max-width:66ch;margin:16px 0 0;color:color-mix(in srgb,currentColor 82%,transparent);font-size:clamp(.96rem,1.15vw,1.1rem);line-height:2.03;text-wrap:pretty}
  .visual-story.atlas-v3 .visual-story__art{min-width:0;position:relative;display:grid;place-items:center}.visual-story.atlas-v3 .visual-story-art{width:100%;max-width:520px;height:auto;overflow:visible}.visual-story.atlas-v3 .art-haze{opacity:.24}.visual-story.atlas-v3 .art-arc,.visual-story.atlas-v3 .art-orbit,.visual-story.atlas-v3 .art-line,.visual-story.atlas-v3 .art-frame,.visual-story.atlas-v3 .art-rays{fill:none;stroke:currentColor;stroke-opacity:.34;stroke-width:1.4}.visual-story.atlas-v3 .art-node{fill:var(--atlas-teal);stroke:var(--atlas-ivory);stroke-width:1.6}.visual-story.atlas-v3 .atlas-v3__scene--deep .visual-story-art{color:#e7ece8}.visual-story.atlas-v3 .atlas-v3__scene--deep .art-node{fill:var(--atlas-teal2)}
  .visual-story.atlas-v3 .atlas-v3__layout--reverse .visual-story__copy{order:2}.visual-story.atlas-v3 .atlas-v3__layout--reverse .visual-story__art{order:1}.visual-story.atlas-v3 .atlas-v3__layout--center{grid-template-columns:1fr;text-align:center}.visual-story.atlas-v3 .atlas-v3__layout--center .visual-story__copy{margin-inline:auto;max-width:78ch}.visual-story.atlas-v3 .atlas-v3__layout--center .visual-story__copy h2{max-width:28ch;margin-inline:auto}.visual-story.atlas-v3 .atlas-v3__layout--center .visual-story__copy p{margin-inline:auto}.visual-story.atlas-v3 .atlas-v3__layout--center .visual-story__art{max-height:32vh}.visual-story.atlas-v3 .atlas-v3__layout--center .visual-story-art{max-width:390px}
  .visual-story.atlas-v3 .atlas-v3__layout--closing{grid-template-columns:1fr;text-align:center;isolation:isolate}.visual-story.atlas-v3 .atlas-v3__layout--closing .visual-story__copy{margin-inline:auto;max-width:78ch}.visual-story.atlas-v3 .atlas-v3__layout--closing .visual-story__copy h2{max-width:28ch;margin-inline:auto}.visual-story.atlas-v3 .atlas-v3__layout--closing .visual-story__copy p{margin-inline:auto}.visual-story.atlas-v3 .atlas-v3__layout--closing .visual-story__art{display:none}.visual-story.atlas-v3 .atlas-v3__signature{position:absolute;z-index:-1;right:-90px;bottom:-120px;width:min(620px,54vw);opacity:.5;filter:drop-shadow(0 12px 26px rgba(0,0,0,.13))}
  .visual-story.atlas-v3 .visual-story__footer{min-height:62px;display:flex;justify-content:center;align-items:center;gap:8px;padding:8px 12px;border-top:1px solid var(--atlas-line);background:rgba(251,248,242,.94);position:relative;z-index:5}.visual-story.atlas-v3 .visual-story__footer>button,.visual-story.atlas-v3 .visual-story__footer>.atlas-v3__home{width:40px;height:40px;min-height:40px;padding:0;border:1px solid var(--atlas-line);border-radius:50%;background:#fff;color:var(--atlas-navy);display:grid;place-items:center;text-decoration:none}.visual-story.atlas-v3 .visual-story__footer>button svg,.visual-story.atlas-v3 .visual-story__footer>.atlas-v3__home svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.visual-story.atlas-v3 .visual-story__footer>button.atlas-v3__next{background:linear-gradient(145deg,var(--atlas-teal),#078f8a);color:#fff;border-color:rgba(18,184,177,.65);box-shadow:0 8px 20px rgba(18,184,177,.18)}.visual-story.atlas-v3 .visual-story__footer>button:disabled{opacity:.32;cursor:not-allowed}.visual-story.atlas-v3 .atlas-v3__count{min-width:64px;text-align:center;color:var(--atlas-muted);font-size:.75rem;font-weight:800;font-variant-numeric:tabular-nums}.visual-story.atlas-v3 .visual-story__dots{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.visual-story.atlas-v3 .atlas-v3__sr-label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.visual-story.atlas-v3 .visual-story__status{min-height:18px;margin:0;padding:0 12px 4px;background:rgba(251,248,242,.94);color:var(--atlas-muted);font-size:.66rem;text-align:center}
  .visual-story.atlas-v3 button:focus-visible,.visual-story.atlas-v3 a:focus-visible{outline:2px solid var(--atlas-gold);outline-offset:3px}
  @media(max-width:900px){.visual-story.atlas-v3 .visual-story__card{grid-template-columns:1fr;gap:18px;align-content:center}.visual-story.atlas-v3 .atlas-v3__layout--reverse .visual-story__copy,.visual-story.atlas-v3 .atlas-v3__layout--reverse .visual-story__art{order:initial}.visual-story.atlas-v3 .visual-story__art{max-height:32vh}.visual-story.atlas-v3 .visual-story-art{max-width:430px}.visual-story.atlas-v3 .atlas-v3__signature{right:-50px;bottom:-65px;width:360px}}
  @media(max-width:720px){.visual-story.atlas-v3 .visual-story__dialog{inset:0;max-width:none;border:0;border-radius:0}.visual-story.atlas-v3 .visual-story__header{min-height:62px;grid-template-columns:minmax(0,1fr) auto auto auto;padding:7px 10px}.visual-story.atlas-v3 .visual-story__brand img{width:43px;height:40px}.visual-story.atlas-v3 .visual-story__brand small{display:none}.visual-story.atlas-v3 .atlas-v3__progress-shell{height:4px}.visual-story.atlas-v3 .visual-story__icon-button{width:38px;height:38px}.visual-story.atlas-v3 .visual-story__card{padding:24px 20px 28px;gap:14px}.visual-story.atlas-v3 .visual-story__copy h2{font-size:clamp(1.5rem,6.7vw,2.1rem)}.visual-story.atlas-v3 .visual-story__copy p{font-size:.9rem;line-height:1.86;margin-top:12px}.visual-story.atlas-v3 .visual-story__art{max-height:27vh}.visual-story.atlas-v3 .visual-story-art{max-width:330px}.visual-story.atlas-v3 .visual-story__footer{min-height:58px}.visual-story.atlas-v3 .visual-story__status{display:none}}
  @media(max-height:520px) and (orientation:landscape){.visual-story.atlas-v3 .visual-story__dialog{grid-template-rows:auto minmax(0,1fr) auto}.visual-story.atlas-v3 .visual-story__header{min-height:48px;padding-block:4px}.visual-story.atlas-v3 .visual-story__brand img{width:38px;height:34px}.visual-story.atlas-v3 .visual-story__brand small,.visual-story.atlas-v3 .atlas-v3__progress-shell{display:none}.visual-story.atlas-v3 .visual-story__card{grid-template-columns:1fr;align-items:center;gap:0;padding:10px 24px}.visual-story.atlas-v3 .visual-story__copy{max-width:none;width:100%}.visual-story.atlas-v3 .visual-story__kicker{font-size:.62rem;margin-bottom:4px}.visual-story.atlas-v3 .visual-story__copy h2{max-width:none;margin-top:3px;font-size:1.25rem;line-height:1.18}.visual-story.atlas-v3 .visual-story__copy p{max-width:none;margin-top:5px;font-size:.72rem;line-height:1.38}.visual-story.atlas-v3 .visual-story__art,.visual-story.atlas-v3 .atlas-v3__signature,.visual-story.atlas-v3 .visual-story__status{display:none!important}.visual-story.atlas-v3 .visual-story__footer{min-height:46px;padding-block:3px}.visual-story.atlas-v3 .visual-story__footer>button,.visual-story.atlas-v3 .visual-story__footer>.atlas-v3__home{width:36px;height:36px;min-height:36px}}
  @media(prefers-reduced-motion:reduce){.visual-story.atlas-v3 .visual-story__card{transition:none}}
</style>