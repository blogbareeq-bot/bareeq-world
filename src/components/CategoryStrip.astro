---
import { categories } from '../config/site';
import type { Post } from '../lib/posts';
import { formatArticleCount } from '../lib/posts';
import CategoryIcon from './CategoryIcon.astro';
import { thumbnailImage } from '../lib/images';

interface Props { posts?: Post[]; }
const { posts = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const publishedPosts = posts.filter((post) => post.data.draft !== true);
const groups = categories.map((category) => {
  const categoryPosts = publishedPosts.filter((post) => post.data.categorySlug === category.slug);
  return {
    ...category,
    articleCount: categoryPosts.length,
    articleCountLabel: formatArticleCount(categoryPosts.length),
    posts: categoryPosts.slice(0, 3)
  };
});
---
<nav class="category-strip" aria-label="أقسام عالم بريق">
  <div class="shell-full category-strip-inner">
    {groups.map((group) => (
      <div
        class:list={['category-nav-item', 'category-theme', `category-theme--${group.slug}`, { active: currentPath.startsWith(`/category/${group.slug}/`) }]}
        data-category-menu-root
      >
        <button
          class="category-nav-trigger"
          type="button"
          data-category-menu-trigger
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls={`category-menu-${group.slug}`}
        >
          <span class="category-icon"><CategoryIcon name={group.icon} /></span>
          <span>{group.name}</span>
          <span class="category-chevron" aria-hidden="true">⌄</span>
        </button>
        <a class="category-mobile-link" href={`/category/${group.slug}/`} aria-current={currentPath.startsWith(`/category/${group.slug}/`) ? 'page' : undefined}>
          <span class="category-icon"><CategoryIcon name={group.icon} /></span>
          <span>{group.name}</span>
        </a>
        <div class="category-dropdown" id={`category-menu-${group.slug}`} data-category-menu aria-hidden="true">
          <a class="category-dropdown-title" href={`/category/${group.slug}/`}>
            <span class="category-icon"><CategoryIcon name={group.icon} /></span>
            <span class="category-dropdown-heading">
              <span class="category-dropdown-name-row">
                <strong>{group.name}</strong>
                <span class="category-article-count">{group.articleCountLabel}</span>
              </span>
              <small>{group.description}</small>
            </span>
          </a>
          {group.posts.length > 0 ? (
            <ol>
              {group.posts.map((post) => (
                <li>
                  <a href={`/posts/${post.id}/`}>
                    {(post.data.thumbnail || post.data.image) ? <img data-src={thumbnailImage(post.data.thumbnail ?? post.data.image)} alt="" loading="lazy" decoding="async" width="112" height="63" /> : <span class="category-dropdown-fallback"><CategoryIcon name={group.icon} /></span>}
                    <strong>{post.data.title}</strong>
                  </a>
                </li>
              ))}
            </ol>
          ) : <p>مقالات هذا القسم قيد الإعداد.</p>}
          <a class="category-dropdown-browse" href={`/category/${group.slug}/`}>تصفح القسم <span aria-hidden="true">←</span></a>
        </div>
      </div>
    ))}
  </div>
</nav>
