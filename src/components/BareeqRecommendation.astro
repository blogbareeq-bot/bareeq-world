---
import type { MonetizationOffer } from '../config/monetization';

interface Props {
  offer: MonetizationOffer;
  articleId: string;
  placement?: 'after-content' | 'article-footer';
  compact?: boolean;
}

const { offer, articleId, placement = 'after-content', compact = false } = Astro.props;
const rel = offer.external ? 'sponsored nofollow noopener noreferrer' : undefined;
---
<aside
  class:list={['bareeq-recommendation', { 'is-compact': compact }, `kind-${offer.kind}`]}
  data-monetization-card
  data-offer-id={offer.id}
  data-offer-kind={offer.kind}
  data-offer-provider={offer.provider ?? 'Bareeq'}
  data-article-id={articleId}
  data-placement={placement}
  aria-label={`${offer.eyebrow}: ${offer.title}`}
>
  <div class="recommendation-mark" aria-hidden="true"><span></span><i></i></div>
  <div class="recommendation-copy">
    <div class="recommendation-head">
      <span class="recommendation-eyebrow">{offer.eyebrow}</span>
      {offer.priceLabel && <span class="recommendation-price">{offer.priceLabel}</span>}
    </div>
    <h2>{offer.title}</h2>
    {!compact && <p>{offer.description}</p>}
    {offer.disclosure && <small class="recommendation-disclosure">{offer.disclosure}</small>}
  </div>
  <a
    class="recommendation-cta"
    href={offer.href}
    target={offer.external ? '_blank' : undefined}
    rel={rel}
    data-monetization-link
  >
    {offer.cta}
    <span aria-hidden="true">←</span>
  </a>
</aside>

<style>
  .bareeq-recommendation {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 1.4rem;
    align-items: center;
    margin: 2.35rem 0 1.5rem;
    padding: 1.35rem 1.45rem;
    border: 1px solid color-mix(in srgb, var(--category-accent, #087566) 30%, transparent);
    border-radius: 22px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--category-accent, #087566) 7%, transparent), transparent 48%),
      var(--surface, #fff);
    box-shadow: 0 18px 45px rgba(10, 35, 66, .07);
    overflow: hidden;
  }
  .bareeq-recommendation::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 1.1rem;
    bottom: 1.1rem;
    width: 3px;
    border-radius: 999px;
    background: var(--category-accent, #087566);
  }
  .recommendation-mark {
    position: absolute;
    inset-inline-end: .9rem;
    inset-block-end: .75rem;
    width: 40px;
    height: 34px;
    opacity: .52;
    pointer-events: none;
  }
  .recommendation-mark::before,
  .recommendation-mark::after {
    content: '';
    position: absolute;
    background: currentColor;
  }
  .recommendation-mark::before { width: 34px; height: 1px; bottom: 2px; right: 2px; }
  .recommendation-mark::after { width: 1px; height: 28px; bottom: 2px; right: 2px; }
  .recommendation-mark span {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    right: -1px;
    bottom: -1px;
    background: #23b7aa;
  }
  .recommendation-mark i::before,
  .recommendation-mark i::after {
    content: '';
    position: absolute;
    width: 11px;
    height: 1.5px;
    right: 19px;
    bottom: 16px;
    background: #d7a33d;
    transform: rotate(45deg);
  }
  .recommendation-mark i::after { transform: rotate(-45deg); }
  .recommendation-head {
    display: flex;
    align-items: center;
    gap: .7rem;
    flex-wrap: wrap;
    margin-bottom: .45rem;
  }
  .recommendation-eyebrow {
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .02em;
    color: var(--category-accent, #087566);
  }
  .recommendation-price {
    padding: .18rem .55rem;
    border-radius: 999px;
    font-size: .78rem;
    font-weight: 800;
    background: color-mix(in srgb, var(--category-accent, #087566) 10%, transparent);
  }
  .recommendation-copy h2 {
    margin: 0;
    font-size: clamp(1.08rem, 1.9vw, 1.32rem);
    line-height: 1.5;
  }
  .recommendation-copy p {
    max-width: 66ch;
    margin: .55rem 0 0;
    color: var(--text-muted, #5c6670);
    line-height: 1.9;
  }
  .recommendation-disclosure {
    display: block;
    margin-top: .7rem;
    color: var(--text-muted, #68727c);
    line-height: 1.75;
  }
  .recommendation-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    min-height: 44px;
    padding: .72rem 1rem;
    border-radius: 14px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    color: #fff;
    background: var(--category-accent, #087566);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .recommendation-cta:hover { transform: translateY(-1px); box-shadow: 0 10px 24px color-mix(in srgb, var(--category-accent, #087566) 20%, transparent); }
  .recommendation-cta:focus-visible { outline: 3px solid color-mix(in srgb, var(--category-accent, #087566) 35%, transparent); outline-offset: 3px; }
  .is-compact { margin-top: 1.1rem; padding-block: 1rem; }
  .is-compact .recommendation-copy h2 { font-size: 1rem; }
  .kind-digital-product { --category-accent: #087566; }

  :global(html[data-theme='dark']) .bareeq-recommendation {
    background: linear-gradient(135deg, rgba(35,183,170,.09), transparent 50%), #0d1f2d;
    border-color: rgba(138, 214, 203, .24);
    box-shadow: none;
  }

  @media (max-width: 700px) {
    .bareeq-recommendation { grid-template-columns: 1fr; padding: 1.15rem 1.15rem 1.3rem; border-radius: 18px; }
    .recommendation-cta { width: 100%; white-space: normal; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .recommendation-cta { transition: none; }
  }
</style>
