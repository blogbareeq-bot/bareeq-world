---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';
interface Props { post: Post; variant?: 'default' | 'horizontal' | 'compact'; eager?: boolean; }
const { post, variant = 'default', eager = false } = Astro.props;
const imageWidth = post.data.imageWidth ?? 1280;
const imageHeight = post.data.imageHeight ?? 720;
---
<article class:list={['post-card', `post-card--${variant}`]} data-post-card data-category={post.data.categorySlug}>
  <a class="post-card-media" href={`/posts/${post.id}/`} aria-label={post.data.title}>
    {post.data.image ? (
      <img
        src={post.data.image}
        alt={post.data.imageAlt ?? post.data.title}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        width={imageWidth}
        height={imageHeight}
        style={`object-position:${post.data.imagePosition ?? 'center'}`}
      />
    ) : <span class="image-fallback" aria-hidden="true">بريق</span>}
  </a>
  <div class="post-card-body">
    <a class="category-chip" href={`/category/${post.data.categorySlug}/`}>{post.data.category}</a>
    <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="post-card-meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <span>{post.data.readingMinutes} دقائق قراءة</span>
    </div>
  </div>
</article>
