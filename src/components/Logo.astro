---
import { site } from '../config/site';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<a class:list={['brand-logo', { compact }]} href="/" aria-label={`${site.name} — الصفحة الرئيسية`}>
  <svg class="brand-mark" viewBox="0 0 72 72" aria-hidden="true">
    <path d="M16 16 37 8v48l-21 8V16Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round"/>
    <path d="M16 16h21M16 40h21M26 13v45" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
    <path class="rays" d="M44 22h16M45 31l14 6M45 13l13-6" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
  </svg>
  <span class="brand-copy">
    <strong>{site.brand}</strong>
    <small>{site.tagline}</small>
  </span>
</a>
