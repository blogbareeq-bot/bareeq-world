---
import { site } from '../config/site';
interface Props { compact?: boolean; inverse?: boolean; }
const { compact = false, inverse = false } = Astro.props;
---
<a class:list={['brand-logo', { compact, inverse }]} href="/" aria-label={`${site.name} — الرئيسية`}>
  <img
    src={site.logo}
    alt={`شعار ${site.brand} — ${site.tagline}`}
    width="2526"
    height="1664"
    decoding="async"
  />
  <span class="visually-hidden">{site.name} — {site.tagline}</span>
</a>
