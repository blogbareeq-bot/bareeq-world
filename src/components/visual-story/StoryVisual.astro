---
interface Props { kind: string; index: number; }
const { kind, index } = Astro.props;
---
<svg class="visual-story-art" data-art={kind} viewBox="0 0 420 260" role="img" aria-label="تكوين بصري تجريدي يخدم فكرة البطاقة">
  <defs>
    <linearGradient id={`story-glow-${index}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--story-accent)" stop-opacity=".92" />
      <stop offset="1" stop-color="var(--story-gold)" stop-opacity=".2" />
    </linearGradient>
    <filter id={`story-blur-${index}`}><feGaussianBlur stdDeviation="16" /></filter>
  </defs>
  <circle class="art-haze" cx="210" cy="130" r="84" fill={`url(#story-glow-${index})`} filter={`url(#story-blur-${index})`} />
  <path class="art-arc art-arc--wide" d="M40 178C112 42 298 38 382 177" />
  <path class="art-arc art-arc--inner" d="M86 180C144 88 281 81 341 179" />
  <circle class="art-orbit" cx="210" cy="130" r="75" />
  <circle class="art-node art-node--one" cx="115" cy="99" r="8" />
  <circle class="art-node art-node--two" cx="302" cy="164" r="6" />
  <path class="art-line" d="M82 198 153 123l54 33 68-79 70 103" />
  <rect class="art-frame" x="123" y="47" width="174" height="166" rx="66" />
  <path class="art-rays" d="M210 29v38M210 193v38M109 130H70M350 130h-39" />
</svg>
