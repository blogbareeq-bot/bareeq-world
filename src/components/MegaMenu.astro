---
import { categories } from '../config/site';
import type { Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
const groups = categories.map((category) => ({
  ...category,
  posts: posts.filter((post) => post.data.categorySlug === category.slug).slice(0, 3)
}));
---
<div class="mega-menu" id="sections-mega-menu" data-mega-menu aria-hidden="true">
  <div class="mega-menu-inner shell-wide">
    <div class="mega-menu-intro">
      <span class="eyebrow">استكشف بريق</span>
      <strong>خمسة أبواب للمعرفة</strong>
      <p>اختر المجال الأقرب إليك، أو ابدأ من أحدث ما نُشر في كل قسم.</p>
      <a href="/articles/">تصفح جميع المقالات</a>
    </div>
    <div class="mega-menu-grid">
      {groups.map((group) => (
        <section class="mega-menu-section" style={`--category-color:${group.color}`}>
          <a class="mega-menu-heading" href={`/category/${group.slug}/`}>
            <span aria-hidden="true">{group.icon}</span>
            <span><strong>{group.name}</strong><small>{group.description}</small></span>
          </a>
          {group.posts.length ? (
            <ol class="mega-menu-posts">
              {group.posts.map((post, index) => (
                <li>
                  <a href={`/posts/${post.id}/`}>
                    <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <strong>{post.data.title}</strong>
                  </a>
                </li>
              ))}
            </ol>
          ) : <p class="mega-menu-empty">مقالات هذا القسم قيد الإعداد.</p>}
          <a class="mega-menu-browse" href={`/category/${group.slug}/`}>تصفح القسم <span aria-hidden="true">←</span></a>
        </section>
      ))}
    </div>
  </div>
</div>
