---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import { getPublishedPosts } from '../lib/posts';
import { site } from '../config/site';
const posts = await getPublishedPosts();
const page = await getEntry('pages', 'about');
---
<BaseLayout title="عن بريق" description={page?.data.description ?? site.description} canonicalPath="/about/" latestPosts={posts.slice(0,6)}>
  <section class="page-hero compact shell"><span class="eyebrow">قصتنا ومنهجنا</span><h1>عن بريق</h1><p>منصة عربية معرفية مستقلة يدير محتواها فريق بريق، وتجمع بين وضوح الفكرة وراحة القراءة.</p></section>
  <div class="shell content-page-wrap">
    <aside class="identity-card">
      <img src={site.logo} alt={`الشعار الرسمي لمدونة ${site.brand}`} width="180" height="180" loading="eager" decoding="async" />
      <p><strong>إدارة المحتوى:</strong> <a href="/team/">فريق بريق</a></p>
      <p><strong>البريد:</strong> <!--email_off--><a href={`mailto:${site.email}`}>{site.email}</a><!--/email_off--></p>
    </aside>
    {page && <ContentPage page={page} />}
  </div>
</BaseLayout>
