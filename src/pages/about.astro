---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
---
<BaseLayout title="من نحن" description="تعرف على رسالة عالم بريق وقيمه" latestPosts={posts.slice(0, 6)}>
  <section class="page-hero shell"><span class="eyebrow">من نحن</span><h1>عالم بريق… نافذتك إلى المعرفة</h1><p>مشروع عربي معرفي يقرّب الفكرة، ويمنح القارئ مساحة هادئة للتأمل والفهم.</p></section>
  <article class="static-page shell prose">
    <h2>رسالتنا</h2>
    <p>نؤمن أن الفكرة الجيدة لا تحتاج إلى تعقيد، وأن المعرفة تصبح أكثر أثرًا حين تُقدّم بلغة واضحة وتصميم مريح واحترام لعقل القارئ.</p>
    <h2>ماذا نقدّم؟</h2>
    <p>مقالات في التفكير والكتب والثقافات والتقنية وتبسيط المفاهيم، ضمن أقسام مترابطة تخدم القارئ العربي الباحث عن محتوى نافع وممتع.</p>
    <h2>قيم بريق</h2>
    <ul><li>الوضوح دون تسطيح.</li><li>الموثوقية دون جفاف.</li><li>الجمال في خدمة المعنى.</li><li>احترام وقت القارئ وخصوصيته.</li></ul>
  </article>
</BaseLayout>
