---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import ValuesStrip from '../components/ValuesStrip.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, formatDate } from '../lib/posts';
import { categories, site } from '../config/site';

const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const sidePosts = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const excluded = new Set([featured?.id, ...sidePosts.map((post) => post.id)]);
const latestPosts = posts.filter((post) => !excluded.has(post.id)).slice(0, 8);
---
<BaseLayout latestPosts={posts.slice(0, 6)}>
  <CategoryStrip />

  {featured && (
    <section class="hero-editorial shell section-gap">
      <article class="hero-featured">
        <a class="hero-link" href={`/posts/${featured.id}/`}>
          {featured.data.image ? (
            <img src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} fetchpriority="high" width="1280" height="720" />
          ) : <span class="image-fallback">بريق</span>}
          <span class="hero-overlay"></span>
          <div class="hero-content">
            <span class="featured-badge">مقال مختار</span>
            <h1>{featured.data.title}</h1>
            <p>{featured.data.description}</p>
            <div class="hero-meta">
              <time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time>
              <span>{featured.data.readingMinutes} دقائق قراءة</span>
            </div>
          </div>
        </a>
      </article>

      <div class="hero-side-list">
        {sidePosts.map((post) => (
          <PostCard post={post} variant="horizontal" />
        ))}
      </div>
    </section>
  )}

  <ValuesStrip />

  <section class="latest-section shell section-gap">
    <div class="section-heading">
      <div>
        <span class="eyebrow">تصفّح المزيد</span>
        <h2>أحدث المقالات</h2>
      </div>
      <a href="/articles/">عرض جميع المقالات</a>
    </div>

    <div class="filter-pills" role="group" aria-label="تصفية أحدث المقالات">
      <button class="active" type="button" data-filter="all" aria-pressed="true">الكل</button>
      {categories.map((category) => (
        <button type="button" data-filter={category.slug} aria-pressed="false">{category.name}</button>
      ))}
    </div>

    <div class="latest-grid" data-latest-grid>
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>

    {latestPosts.length === 0 && (
      <div class="empty-state">
        <h2>المحتوى قيد التجهيز</h2>
        <p>أضف مقالات جديدة إلى مجلد المحتوى، وستظهر هنا تلقائيًا.</p>
      </div>
    )}
  </section>

  <section class="knowledge-banner shell section-gap">
    <div>
      <span class="eyebrow">عالم بريق</span>
      <h2>معرفة هادئة، تصميم مريح، ومحتوى يبقى معك</h2>
      <p>{site.description}</p>
    </div>
    <a class="button primary" href="/about/">اعرف قصتنا</a>
  </section>

  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-filter]')];
      const cards = [...document.querySelectorAll('[data-post-card]')];
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.dataset.filter;
          buttons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('active', active);
            item.setAttribute('aria-pressed', String(active));
          });
          cards.forEach((card) => {
            card.hidden = filter !== 'all' && card.dataset.category !== filter;
          });
        });
      });
    })();
  </script>
</BaseLayout>
