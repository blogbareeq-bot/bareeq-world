---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, formatArticleCount } from '../../lib/posts';
import { categories } from '../../config/site';
const posts = await getPublishedPosts();
---
<BaseLayout title="جميع المقالات" description="تصفح جميع مقالات عالم بريق في العقل والكتب والثقافة والتقنية وتبسيط المفاهيم." canonicalPath="/articles/" latestPosts={posts.slice(0,6)}>
  <section class="page-hero compact shell"><span class="eyebrow">المكتبة الكاملة</span><h1>جميع المقالات</h1><p>{formatArticleCount(posts.length)} موزعة على أقسام بريق الخمسة.</p></section>
  <section class="shell section-gap archive-section">
    <div class="filter-pills" role="group" aria-label="تصفية المقالات">
      <button class="active" type="button" data-filter="all" aria-pressed="true">الكل</button>
      {categories.filter((category) => posts.some((post) => post.data.categorySlug === category.slug)).map((category) => <button type="button" data-filter={category.slug} aria-pressed="false">{category.name}</button>)}
    </div>
    <div class="archive-grid" data-archive-grid>{posts.map((post) => <PostCard post={post} headingLevel="h2" />)}</div>
    <p class="filter-empty" data-filter-empty hidden>لا توجد مقالات في هذا القسم حاليًا.</p>
  </section>
  <script is:inline src="/scripts/articles.js"></script>
</BaseLayout>
