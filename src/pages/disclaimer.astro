---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
const page = await getEntry('pages', 'disclaimer');
---
<BaseLayout title="إخلاء المسؤولية" description={page?.data.description} canonicalPath="/disclaimer/" latestPosts={posts.slice(0,6)}>
  <section class="page-hero compact shell"><span class="eyebrow">تنبيه مهم</span><h1>إخلاء المسؤولية</h1><p>المحتوى للتثقيف والمعرفة العامة ولا يغني عن المختصين.</p></section>
  <div class="shell narrow-page">{page && <ContentPage page={page} />}</div>
</BaseLayout>
