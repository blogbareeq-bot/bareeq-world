---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { getAgentsCheckoutUrl } from '../../config/monetization';
import { site } from '../../config/site';

const latestPosts = (await getPublishedPosts()).slice(0, 6);
const checkoutUrl = getAgentsCheckoutUrl();
const emailSubject = encodeURIComponent('طلب حزمة بريق العملية للوكلاء الأذكياء');
const emailBody = encodeURIComponent('مرحبًا فريق بريق،\n\nأرغب في شراء حزمة بريق العملية للوكلاء الأذكياء (الإصدار 1.0) بسعر 29 ر.س.\n\nشكرًا.');
const fallbackHref = `mailto:${site.email}?subject=${emailSubject}&body=${emailBody}`;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'حزمة بريق العملية للوكلاء الأذكياء',
  description: 'دليل عملي عربي لبناء أول سير عمل لوكيل ذكي بأقل صلاحيات لازمة، مع 20 برومبت وقالب عمل وقائمة أمان.',
  brand: { '@type': 'Brand', name: 'بريق' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'SAR',
    price: '29',
    availability: checkoutUrl ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    url: new URL('/products/agents-starter-kit/', site.url).toString()
  }
};
---
<BaseLayout
  title="حزمة بريق العملية للوكلاء الأذكياء"
  description="حزمة عربية عملية لبناء أول سير عمل لوكيل ذكي: دليل، 20 برومبت، قالب تنفيذ، وقائمة أمان وصلاحيات."
  canonicalPath="/products/agents-starter-kit/"
  latestPosts={latestPosts}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>

  <section class="product-hero shell">
    <div class="hero-copy">
      <span class="eyebrow">أداة بريق · الإصدار 1.0</span>
      <h1>من فكرة «الوكيل الذكي» إلى أول سير عمل آمن وقابل للقياس</h1>
      <p class="hero-lead">الحزمة ليست مجموعة أوامر سحرية. إنها نظام عملي صغير يساعدك على اختيار المهمة المناسبة، ضبط الصلاحيات، اختبار الفشل، وقياس النتيجة قبل التوسع.</p>
      <div class="hero-price"><strong>29 ر.س</strong><span>دفعة واحدة</span></div>
      <a
        class="primary-cta"
        href={checkoutUrl || fallbackHref}
        target={checkoutUrl ? '_blank' : undefined}
        rel={checkoutUrl ? 'noopener noreferrer' : undefined}
        data-checkout-link={checkoutUrl ? true : undefined}
        data-product-id="bareeq-agents-starter-kit-v1"
        data-product-name="حزمة بريق العملية للوكلاء الأذكياء"
        data-currency="SAR"
        data-value="29"
      >{checkoutUrl ? 'شراء الحزمة الآن' : 'اطلب الحزمة من بريق'} <span aria-hidden="true">←</span></a>
      {!checkoutUrl && <p class="checkout-note">الدفع المباشر لم يُربط بعد؛ يفتح الزر رسالة طلب جاهزة إلى بريق. لن نطلب منك بيانات بطاقة عبر البريد.</p>}
    </div>
    <div class="product-card" aria-label="محتويات الحزمة">
      <div class="card-mark" aria-hidden="true"><span></span></div>
      <span>داخل الحزمة</span>
      <strong>4 أدوات في ملف واحد</strong>
      <ul>
        <li>دليل PDF عملي</li>
        <li>20 برومبت جاهزًا للتكييف</li>
        <li>قالب سير عمل من صفحة واحدة</li>
        <li>قائمة فحص للأمان والصلاحيات</li>
      </ul>
    </div>
  </section>

  <section class="product-section shell narrow">
    <span class="eyebrow">لمن صُممت؟</span>
    <h2>لمن يريد أن يستخدم الوكلاء بدل أن يكتفي بالكلام عنهم</h2>
    <div class="three-grid">
      <article><strong>للموظف وصاحب العمل</strong><p>إذا كانت لديك مهام متكررة بين البريد والملفات والتقارير وتريد معرفة أين يستحق الوكيل التجربة.</p></article>
      <article><strong>لصانع المحتوى والباحث</strong><p>إذا أردت بحثًا وتجميعًا وQA أكثر انضباطًا من «ابحث ولخّص» بلا حدود واضحة.</p></article>
      <article><strong>للمهتم بالذكاء الاصطناعي</strong><p>إذا فهمت الفكرة نظريًا وتريد قالبًا يساعدك على بناء تجربة صغيرة قابلة للقياس.</p></article>
    </div>
  </section>

  <section class="product-section shell narrow">
    <span class="eyebrow">ماذا ستنجز؟</span>
    <h2>النتيجة المقصودة: سير عمل واحد يعمل بحدود واضحة</h2>
    <ol class="steps">
      <li><b>اختيار:</b> تميّز متى تحتاج وكيلًا ومتى تكفي محادثة أو أتمتة ثابتة.</li>
      <li><b>تصميم:</b> تحدد الهدف والمدخلات والأدوات والممنوعات ونقطة الموافقة.</li>
      <li><b>اختبار:</b> تبني حالات طبيعية وحالات حافة وتفحص أين يمكن أن يفشل النظام.</li>
      <li><b>أمان:</b> تمنح أقل صلاحية ممكنة وتضع شروط توقف صريحة.</li>
      <li><b>قياس:</b> تقارن الزمن والدقة والتكلفة قبل وبعد بدل الاعتماد على الانطباع.</li>
    </ol>
  </section>

  <section class="product-section shell narrow promise">
    <div>
      <span class="eyebrow">ما لن نعدك به</span>
      <h2>لا «موظف رقمي يعمل وحده وأنت نائم»</h2>
    </div>
    <p>الحزمة لا تعد باستقلالية خيالية ولا تناسب كل مهمة. وهي لا تستبدل سياسات مؤسستك أو مراجعة الأمان والخصوصية. هدفها أبسط وأكثر فائدة: أن تجعل التجربة الأولى محددة، قابلة للفحص، وأقل عرضة للأخطاء المكلفة.</p>
  </section>

  <section class="final-cta shell narrow">
    <span class="eyebrow">ابدأ صغيرًا</span>
    <h2>مهمة واحدة. صلاحيات أقل. قياس أوضح.</h2>
    <p>اقرأ المقال أولًا إن أردت فهم المفهوم، أو انتقل مباشرة إلى الحزمة إذا كنت جاهزًا للتطبيق.</p>
    <div class="final-actions">
      <a class="secondary-cta" href="/posts/ai-agents-future-now/">اقرأ مقال الوكلاء الأذكياء</a>
      <a
        class="primary-cta"
        href={checkoutUrl || fallbackHref}
        target={checkoutUrl ? '_blank' : undefined}
        rel={checkoutUrl ? 'noopener noreferrer' : undefined}
        data-checkout-link={checkoutUrl ? true : undefined}
        data-product-id="bareeq-agents-starter-kit-v1"
        data-product-name="حزمة بريق العملية للوكلاء الأذكياء"
        data-currency="SAR"
        data-value="29"
      >{checkoutUrl ? 'شراء الحزمة - 29 ر.س' : 'اطلب الحزمة - 29 ر.س'}</a>
    </div>
  </section>

  <script is:inline src="/scripts/monetization.js"></script>
</BaseLayout>

<style>
  .product-hero { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr); gap:clamp(2rem,5vw,5rem); align-items:center; padding-block:clamp(3rem,8vw,7rem); }
  .hero-copy h1 { max-width:18ch; margin:.55rem 0 1rem; font-size:clamp(2rem,5vw,4.5rem); line-height:1.25; letter-spacing:-.025em; }
  .hero-lead { max-width:62ch; color:var(--text-muted,#5f6973); font-size:clamp(1.05rem,1.8vw,1.25rem); line-height:2; }
  .eyebrow { color:#087566; font-weight:800; font-size:.86rem; }
  .hero-price { display:flex; align-items:baseline; gap:.75rem; margin:1.35rem 0; }
  .hero-price strong { font-size:2rem; color:#0a2342; } .hero-price span { color:var(--text-muted,#69727b); }
  .primary-cta,.secondary-cta { display:inline-flex; align-items:center; justify-content:center; gap:.45rem; min-height:48px; padding:.82rem 1.2rem; border-radius:14px; text-decoration:none; font-weight:800; }
  .primary-cta { color:#fff; background:#087566; box-shadow:0 14px 28px rgba(8,117,102,.16); }
  .secondary-cta { color:#0a2342; border:1px solid rgba(10,35,66,.18); background:transparent; }
  .checkout-note { max-width:55ch; margin:.75rem 0 0; color:var(--text-muted,#6a747d); font-size:.88rem; line-height:1.8; }
  .product-card { position:relative; min-height:340px; padding:2rem; border-radius:32px; color:#eaf9f7; background:radial-gradient(circle at 70% 28%,rgba(35,183,170,.22),transparent 34%),linear-gradient(145deg,#0a2342,#071421); box-shadow:0 30px 70px rgba(7,20,33,.2); overflow:hidden; }
  .product-card>span { color:#73d6ca; font-size:.83rem; font-weight:800; } .product-card>strong { display:block; max-width:11ch; margin:.6rem 0 1.5rem; font-size:2rem; line-height:1.4; }
  .product-card ul { display:grid; gap:.8rem; padding:0; margin:0; list-style:none; } .product-card li::before { content:'✓'; margin-inline-end:.55rem; color:#d9b150; font-weight:900; }
  .card-mark { position:absolute; inset-inline-end:1.7rem; inset-block-end:1.4rem; width:70px; height:60px; border-right:2px solid rgba(255,255,255,.55); border-bottom:2px solid rgba(255,255,255,.55); }
  .card-mark::before,.card-mark::after { content:''; position:absolute; width:18px; height:2px; right:34px; bottom:30px; background:#d9b150; transform:rotate(45deg); } .card-mark::after { transform:rotate(-45deg); }
  .card-mark span { position:absolute; width:9px; height:9px; border-radius:50%; right:-5px; bottom:-5px; background:#23b7aa; }
  .narrow { max-width:980px; } .product-section { padding-block:clamp(2.8rem,6vw,5rem); }
  .product-section h2,.final-cta h2 { margin:.5rem 0 1.2rem; font-size:clamp(1.6rem,3vw,2.5rem); line-height:1.45; }
  .three-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-top:1.6rem; }
  .three-grid article { padding:1.25rem; border:1px solid rgba(10,35,66,.1); border-radius:20px; background:var(--surface,#fff); } .three-grid strong { color:#0a2342; } .three-grid p { color:var(--text-muted,#66717b); line-height:1.85; }
  .steps { display:grid; gap:.75rem; padding:0; list-style:none; counter-reset:step; } .steps li { counter-increment:step; padding:1rem 1.15rem; border-radius:16px; background:rgba(8,117,102,.055); line-height:1.9; } .steps li::before { content:counter(step); display:inline-grid; place-items:center; width:28px; height:28px; margin-inline-end:.65rem; border-radius:50%; color:#fff; background:#087566; font-weight:800; }
  .promise { display:grid; grid-template-columns:.9fr 1.1fr; gap:2rem; align-items:start; border-block:1px solid rgba(10,35,66,.1); } .promise p { margin:0; color:var(--text-muted,#65707a); line-height:2; }
  .final-cta { margin-block:3rem 5rem; padding:2rem; border-radius:26px; background:linear-gradient(135deg,rgba(8,117,102,.08),rgba(217,177,80,.08)); text-align:center; } .final-cta p { color:var(--text-muted,#66717b); } .final-actions { display:flex; gap:.8rem; justify-content:center; flex-wrap:wrap; margin-top:1.3rem; }
  :global(html[data-theme='dark']) .hero-price strong,:global(html[data-theme='dark']) .secondary-cta,:global(html[data-theme='dark']) .three-grid strong { color:#eaf3f7; }
  :global(html[data-theme='dark']) .three-grid article { border-color:rgba(255,255,255,.1); background:#0d1f2d; }
  :global(html[data-theme='dark']) .steps li { background:rgba(35,183,170,.08); }
  :global(html[data-theme='dark']) .promise { border-color:rgba(255,255,255,.1); }
  @media(max-width:820px){ .product-hero,.promise{grid-template-columns:1fr}.three-grid{grid-template-columns:1fr}.product-card{min-height:300px}.hero-copy h1{max-width:none}.primary-cta{width:100%} }
</style>
