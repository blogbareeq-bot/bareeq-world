---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatArticleCount } from '../../lib/posts';
import { archivePolicy, series } from '../../config/site';
const posts = await getPublishedPosts();
const visibleSeries = series
  .map((item) => ({ item, count: posts.filter((post) => post.data.seriesSlug === item.slug).length }))
  .filter(({ count }) => count >= archivePolicy.minPostsToShowSeries);
---
<BaseLayout title="سلاسل بريق" description="مسارات قراءة مترابطة تجمع مقالات عالم بريق بحسب الفكرة والموضوع، وتساعدك على متابعة المعرفة بترتيب واضح." canonicalPath="/series/" latestPosts={posts.slice(0,6)}>
  <section class="page-hero compact shell"><span class="eyebrow">رحلات معرفية</span><h1>سلاسل بريق</h1><p>اختر مسارًا واقرأ مجموعة مترابطة من المقالات بترتيب مقصود، بدل التنقل العشوائي.</p></section>
  <section class="shell section-gap"><div class="series-grid series-grid-large">
    {visibleSeries.map(({ item, count }) => {
      return <a class="series-card" href={`/series/${item.slug}/`}><span>{formatArticleCount(count)} · مسار قراءة</span><h2>{item.title}</h2><p>{item.promise}</p><strong>ابدأ المسار ←</strong></a>;
    })}
  </div></section>
</BaseLayout>
