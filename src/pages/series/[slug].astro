---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { formatArticleCount, getPublishedPosts, getSeriesEntries } from '../../lib/posts';
import { archivePolicy, series } from '../../config/site';
export function getStaticPaths() { return series.map((item) => ({ params:{slug:item.slug}, props:{item} })); }
const { item } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = getSeriesEntries(item.slug, allPosts);
---
<BaseLayout title={item.title} description={item.description} canonicalPath={`/series/${item.slug}/`} latestPosts={allPosts.slice(0,6)} noindex={posts.length < archivePolicy.minPostsToIndexSeries}>
  <section class="page-hero compact shell"><span class="eyebrow">سلسلة بريق</span><h1>{item.title}</h1><p>{item.description}</p></section>
  <section class="shell series-promise section-gap" aria-labelledby="series-promise-title">
    <span class="eyebrow">وعد المسار</span>
    <h2 id="series-promise-title">ماذا ستخرج به؟</h2>
    <p>{item.promise}</p>
    <p class="series-promise-count">{formatArticleCount(posts.length)} مرتبة بقصد تحريري، لا بتاريخ النشر وحده.</p>
  </section>
  <section class="shell section-gap">
    <ol class="series-path-list">
      {posts.map((post, index) => (
        <li>
          <span class="series-path-step" aria-hidden="true">{index + 1}</span>
          <PostCard post={post} headingLevel="h2" />
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
