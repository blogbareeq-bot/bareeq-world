---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, uniqueTags } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return uniqueTags(posts).map((tag) => ({ params: { tag }, props: { tag } }));
}
const { tag } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => post.data.tags.includes(tag));
---
<BaseLayout title={`وسم: ${tag}`} description={`اقرأ مقالات عالم بريق المرتبطة بموضوع ${tag}، مع أفكار واضحة وروابط لمحتوى ذي صلة.`} canonicalPath={`/tags/${encodeURIComponent(tag)}/`} latestPosts={allPosts.slice(0,6)} noindex={posts.length < 2}>
  <section class="page-hero compact shell"><span class="eyebrow">وسم معرفي</span><h1>#{tag}</h1><p>{posts.length} مقالات مرتبطة بهذا الوسم.</p></section>
  <section class="shell section-gap"><div class="archive-grid">{posts.map((post) => <PostCard post={post} headingLevel="h2" />)}</div></section>
</BaseLayout>
