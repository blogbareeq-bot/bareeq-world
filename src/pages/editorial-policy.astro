---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
const page = await getEntry('pages', 'editorial-policy');
---
<BaseLayout title="سياسة التحرير والتصحيح" description={page?.data.description} canonicalPath="/editorial-policy/" latestPosts={posts.slice(0,6)}>
  <section class="page-hero compact shell"><span class="eyebrow">الثقة تبدأ بالوضوح</span><h1>سياسة التحرير والتصحيح</h1><p>كيف نختار المصادر، ونراجع الادعاءات، ونتعامل مع الأخطاء والتحديثات.</p></section>
  <div class="shell narrow-page">{page && <ContentPage page={page} />}</div>
</BaseLayout>
