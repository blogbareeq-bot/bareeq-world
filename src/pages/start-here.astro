---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { categories } from '../config/site';
const posts = await getPublishedPosts();
const starters = categories.map((category) => posts.find((post) => post.data.categorySlug === category.slug)).filter(Boolean);
---
<BaseLayout title="ابدأ من هنا" description="دليل واضح للزائر الجديد لاكتشاف عالم بريق وأقسامه الخمسة، واختيار أول مقال ومسار قراءة مناسب لاهتمامه." canonicalPath="/start-here/" latestPosts={posts.slice(0,6)}>
  <section class="page-hero shell"><span class="eyebrow">مرحبًا بك</span><h1>ابدأ من هنا</h1><p>بريق منصة معرفية عربية تجمع العقل والكتب والثقافة والتقنية وتبسيط المفاهيم. اختر الباب الأقرب إلى فضولك.</p></section>
  <section class="shell start-steps section-gap">
    <article><span>1</span><h2>اختر قسمًا</h2><p>تعرّف على المسارات الخمسة من شريط الأقسام في أعلى الموقع.</p></article>
    <article><span>2</span><h2>اقرأ مقالًا كاملًا</h2><p>استخدم جدول المحتويات وشريط التقدم لتجربة قراءة مريحة.</p></article>
    <article><span>3</span><h2>استكشف سلسلة</h2><p>انتقل إلى سلاسل بريق عندما تريد متابعة موضوع يمتد عبر أكثر من مقال؛ وتظهر السلسلة بعد نشر مقالتين مترابطتين على الأقل.</p></article>
  </section>
  <section class="shell section-gap">
    <div class="section-heading"><div><span class="eyebrow">اختيارات البداية</span><h2>مقال من كل مسار</h2></div></div>
    <div class="archive-grid">{starters.map((post) => post && <PostCard post={post} />)}</div>
  </section>
</BaseLayout>
