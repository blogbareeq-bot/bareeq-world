---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import '../styles/global.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/arabic-800.css';
import cairoHeadingFont from '@fontsource/cairo/files/cairo-arabic-700-normal.woff2?url';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import ibmBodyFont from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import { site } from '../config/site';
import type { Post } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  preloadImage?: string;
  preloadSrcset?: string;
  preloadSizes?: string;
  canonicalPath?: string;
  latestPosts?: Post[];
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
}

const {
  title = site.name,
  description = site.description,
  image = site.socialImage,
  imageWidth = site.socialImageWidth,
  imageHeight = site.socialImageHeight,
  preloadImage,
  preloadSrcset,
  preloadSizes,
  canonicalPath = Astro.url.pathname,
  latestPosts = [],
  type = 'website',
  noindex = false,
  publishedAt,
  updatedAt
} = Astro.props;

const cleanDescription = description.replace(/\s+/g, ' ').trim();
const metaDescription = cleanDescription.length > 160 ? `${cleanDescription.slice(0, 157).trimEnd()}…` : cleanDescription;
const brandedTitle = `${title} | ${site.name}`;
const fullTitle = title === site.name
  ? `${site.name} — ${site.tagline}`
  : brandedTitle.length <= 65 ? brandedTitle : title;
const canonical = new URL(canonicalPath, Astro.site ?? site.url).toString();
const socialImage = new URL(image || site.socialImage, Astro.site ?? site.url).toString();
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    alternateName: site.brand,
    url: site.url,
    logo: { '@type': 'ImageObject', url: new URL(site.logo, site.url).toString(), width: 180, height: 180 },
    email: site.email,
    description: site.description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    alternateName: site.brand,
    description: site.description,
    inLanguage: 'ar',
    publisher: { '@id': `${site.url}/#organization` },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site.url}/search/?q={search_term_string}` },
      'query-input': 'required name=search_term_string'
    }
  }
];
---
<!doctype html>
<html lang="ar" dir="rtl" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAF9F6" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content="فريق بريق" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={site.originalLogo} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="عالم بريق" href="/rss.xml" />
    <link rel="preload" as="font" type="font/woff2" href={cairoHeadingFont} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={ibmBodyFont} crossorigin="anonymous" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadSrcset} imagesizes={preloadSizes} fetchpriority="high" />}

    <meta property="og:locale" content="ar_AR" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)}></script>
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">انتقل إلى المحتوى</a>
    <Header latestPosts={latestPosts} />
    <main id="main-content"><slot /></main>
    <Footer />
    <AnalyticsConsent />
    <button class="back-to-top" type="button" data-back-top aria-label="العودة إلى أعلى الصفحة">↑</button>
    <script>
      (() => {
        const root = document.documentElement;
        const themeToggle = document.querySelector('[data-theme-toggle]');
        const syncThemeButton = () => themeToggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
        syncThemeButton();
        themeToggle?.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('bareeq-theme', next); } catch {}
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#071421' : '#FAF9F6');
          syncThemeButton();
        });

        const stickyHeader = document.querySelector('[data-sticky-header]');
        const updateStickyHeader = () => stickyHeader?.classList.toggle('is-scrolled', scrollY > 36);
        addEventListener('scroll', updateStickyHeader, { passive: true });
        updateStickyHeader();

        const categoryRoots = [...document.querySelectorAll('[data-category-menu-root]')];
        const setCategoryMenu = (root, open) => {
          const trigger = root.querySelector('[data-category-menu-trigger]');
          const menu = root.querySelector('[data-category-menu]');
          root.classList.toggle('is-open', open);
          trigger?.setAttribute('aria-expanded', String(open));
          menu?.setAttribute('aria-hidden', String(!open));
          if (open) {
            menu?.querySelectorAll('img[data-src]').forEach((image) => {
              if (!(image instanceof HTMLImageElement)) return;
              image.src = image.dataset.src ?? '';
              image.removeAttribute('data-src');
            });
          }
        };
        const closeCategoryMenus = (except = null) => {
          categoryRoots.forEach((root) => {
            if (root !== except) setCategoryMenu(root, false);
          });
        };
        categoryRoots.forEach((root) => {
          const trigger = root.querySelector('[data-category-menu-trigger]');
          const menu = root.querySelector('[data-category-menu]');
          trigger?.addEventListener('click', () => {
            const finePointer = matchMedia('(hover:hover) and (pointer:fine)').matches;
            const willOpen = finePointer ? true : !root.classList.contains('is-open');
            closeCategoryMenus(root);
            setCategoryMenu(root, willOpen);
          });
          trigger?.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowDown') {
              event.preventDefault();
              closeCategoryMenus(root);
              setCategoryMenu(root, true);
              const focusFirstLink = () => {
                if (!root.classList.contains('is-open')) return;
                const first = menu?.querySelector('a');
                if (first instanceof HTMLElement) first.focus({ preventScroll: true });
              };
              requestAnimationFrame(focusFirstLink);
              setTimeout(focusFirstLink, 210);
            }
          });
          root.addEventListener('focusout', (event) => {
            if (!root.contains(event.relatedTarget)) setCategoryMenu(root, false);
          });
          root.addEventListener('pointerenter', () => {
            if (matchMedia('(hover:hover) and (pointer:fine)').matches) {
              closeCategoryMenus(root);
              setCategoryMenu(root, true);
            }
          });
          root.addEventListener('pointerleave', () => {
            if (matchMedia('(hover:hover) and (pointer:fine)').matches) setCategoryMenu(root, false);
          });
          root.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && root.classList.contains('is-open')) {
              event.preventDefault();
              setCategoryMenu(root, false);
              if (trigger instanceof HTMLElement) trigger.focus();
            }
          });
        });
        document.addEventListener('click', (event) => {
          if (!categoryRoots.some((root) => root.contains(event.target))) closeCategoryMenus();
        });

        const ticker = document.querySelector('[data-ticker]');
        const tickerToggle = document.querySelector('[data-ticker-toggle]');
        const setTickerPaused = (paused) => {
          ticker?.classList.toggle('is-paused', paused);
          tickerToggle?.setAttribute('aria-pressed', String(paused));
          tickerToggle?.setAttribute('aria-label', paused ? 'تشغيل حركة أحدث المقالات' : 'إيقاف حركة أحدث المقالات');
          if (tickerToggle) tickerToggle.textContent = paused ? '▶' : 'Ⅱ';
          try { localStorage.setItem('bareeq-ticker-paused', paused ? '1' : '0'); } catch {}
        };
        let tickerPaused = false;
        try { tickerPaused = localStorage.getItem('bareeq-ticker-paused') === '1'; } catch {}
        setTickerPaused(tickerPaused);
        tickerToggle?.addEventListener('click', () => {
          tickerPaused = !ticker?.classList.contains('is-paused');
          setTickerPaused(tickerPaused);
        });

        const drawer = document.querySelector('[data-mobile-drawer]');
        const panel = drawer?.querySelector('.drawer-panel');
        const openButton = document.querySelector('[data-menu-open]');
        const closeButton = document.querySelector('[data-menu-close]');
        let previousFocus = null;
        const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';
        const closeDrawer = () => {
          drawer?.classList.remove('is-open');
          drawer?.setAttribute('aria-hidden', 'true');
          if (drawer instanceof HTMLElement) drawer.inert = true;
          openButton?.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('drawer-open');
          if (previousFocus instanceof HTMLElement) previousFocus.focus();
        };
        const openDrawer = () => {
          previousFocus = document.activeElement;
          drawer?.classList.add('is-open');
          drawer?.setAttribute('aria-hidden', 'false');
          if (drawer instanceof HTMLElement) drawer.inert = false;
          openButton?.setAttribute('aria-expanded', 'true');
          document.body.classList.add('drawer-open');
          const first = panel?.querySelector(focusableSelector);
          if (first instanceof HTMLElement) first.focus();
        };
        openButton?.addEventListener('click', openDrawer);
        closeButton?.addEventListener('click', closeDrawer);
        drawer?.addEventListener('click', (event) => { if (event.target === drawer) closeDrawer(); });
        drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeDrawer));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && drawer?.classList.contains('is-open')) closeDrawer();
          if (event.key === 'Tab' && drawer?.classList.contains('is-open') && panel) {
            const focusable = [...panel.querySelectorAll(focusableSelector)].filter((el) => el instanceof HTMLElement && !el.hasAttribute('hidden'));
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
            else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
          }
        });

        const footerQuery = matchMedia('(max-width: 700px)');
        const footerDetails = [...document.querySelectorAll('[data-footer-details]')];
        const syncFooterDetails = () => footerDetails.forEach((details) => {
          if (details instanceof HTMLDetailsElement) details.open = !footerQuery.matches;
        });
        footerQuery.addEventListener?.('change', syncFooterDetails);
        syncFooterDetails();

        document.querySelectorAll('a[target="_blank"]').forEach((link) => {
          const rel = new Set((link.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
          rel.add('noopener'); rel.add('noreferrer');
          link.setAttribute('rel', [...rel].join(' '));
        });

        const backTop = document.querySelector('[data-back-top]');
        const updateBackTop = () => backTop?.classList.toggle('visible', scrollY > 500);
        addEventListener('scroll', updateBackTop, { passive: true });
        backTop?.addEventListener('click', () => scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }));
        updateBackTop();
      })();
    </script>
  </body>
</html>
