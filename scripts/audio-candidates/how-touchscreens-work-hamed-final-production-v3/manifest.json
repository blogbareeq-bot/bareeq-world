    {
      "characters": 1550,
      "sync": [
        {
          "id": "b0014",
          "type": "paragraph",
          "match": "ما نسميه عادة الشاشة ليس طبقة واحدة هناك زجاج الحماية الخارجي وتحته طبقات الاستشعار والعرض ثم لوحة oled أو lcd التي تنتج",
